---
import { getCollection } from 'astro:content';

const productos = await getCollection('productos');

const whatsapp = '5491156423421';

const grupos = [...new Set(productos.map(p => p.data.grupo || 'Otros'))];
---

<html lang="es">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<title>Ferreser Herramientas</title>

<style>
  body {
    font-family: Arial, sans-serif;
    background: #f5f5f5;
    margin: 0;
    padding: 20px;
  }

  .header {
    background: #222;
    color: white;
    padding: 25px;
    border-radius: 12px;
    margin-bottom: 30px;
  }

  .header h1 {
    margin: 0 0 10px 0;
  }

  .header a {
    color: #25D366;
    font-weight: bold;
    text-decoration: none;
  }

  .grupo-titulo {
    margin-top: 40px;
    margin-bottom: 20px;
    color: #222;
    border-left: 6px solid #25D366;
    padding-left: 12px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill,minmax(320px,1fr));
    gap: 20px;
  }

  .card {
    background: white;
    border-radius: 12px;
    padding: 16px;
    box-shadow: 0 2px 10px rgba(0,0,0,.08);
    position: relative;
  }

  .destacado {
    position: absolute;
    top: 10px;
    right: 10px;
    background: #ff5722;
    color: white;
    padding: 6px 10px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: bold;
  }

  .image-container {
    height: 250px;
    display: flex;
    justify-content: center;
    align-items: center;
    margin-bottom: 15px;
  }

  .image-container img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .card h2 {
    min-height: 70px;
    margin-bottom: 10px;
  }

  .card .descripcion {
    min-height: 80px;
  }

  .precio {
    color: green;
    font-weight: bold;
    font-size: 28px;
    margin: 15px 0;
  }

  .btn-wpp {
    display: block;
    text-align: center;
    background: #25D366;
    color: white;
    text-decoration: none;
    font-weight: bold;
    padding: 12px;
    border-radius: 8px;
    margin-top: 15px;
  }

  .btn-wpp:hover {
    background: #1fa851;
  }

  .wpp-float {
    position: fixed;
    bottom: 20px;
    right: 20px;
    width: 65px;
    height: 65px;
    background: #25D366;
    color: white;
    border-radius: 50%;
    text-decoration: none;
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 32px;
    box-shadow: 0 4px 10px rgba(0,0,0,.3);
  }
  .badge-verde{
  display:inline-block;
  background:#d4edda;
  color:#155724;
  padding:6px 10px;
  border-radius:6px;
  font-size:12px;
  font-weight:bold;
  margin-bottom:10px;
}

.badge-naranja{
  display:inline-block;
  background:#fff3cd;
  color:#856404;
  padding:6px 10px;
  border-radius:6px;
  font-size:12px;
  font-weight:bold;
  margin-bottom:10px;
}
</style>
</head>

<body>

<div class="header">
  <h1>🔧 Ferreser Herramientas</h1>

  <p>
    📞 WhatsApp:
    <a href={`https://wa.me/${whatsapp}`} target="_blank">
      11 5642-3421
    </a>
  </p>

  <p>
    📍 Zona Sur y CABA
  </p>
</div>

{
  grupos.map(grupo => (
    <>
      <h2 class="grupo-titulo">{grupo}</h2>

      <div class="grid">

        {
          productos
            .filter(p => (p.data.grupo || 'Otros') === grupo)
            .map(producto => (

            <div class="card">

              {
                producto.data.destacado && (
                  <div class="destacado">
                    🔥 OFERTA
                  </div>
                )
              }

              {
  producto.data.grupo === 'Kits' ? (
    <div class="badge-kit">
      🧰 Kit completo
    </div>
  ) : producto.data.incluye_bateria ? (
    <div class="badge-verde">
      🔋 Con batería
    </div>
  ) : (
    <div class="badge-naranja">
      ⚡ Solo herramienta
    </div>
  )
}

              <div class="image-container">
                <img
                  src={producto.data.image}
                  alt={producto.data.title}
                />
              </div>

              <h2>{producto.data.title}</h2>

              <p class="descripcion">
                {producto.data.description}
              </p>

              <p class="precio">
                ${producto.data.price}
              </p>

              <p>
                Categoría: {producto.data.category}
              </p>

              <a
                class="btn-wpp"
                href={`https://wa.me/${whatsapp}?text=Hola, consulto por ${producto.data.title}`}
                target="_blank"
              >
                Consultar por WhatsApp
              </a>

            </div>

          ))
        }
      </div>
    </>
  ))
}

<a
  href={`https://wa.me/${whatsapp}`}
  class="wpp-float"
  target="_blank"
>
💬
</a>

</body>
</html>