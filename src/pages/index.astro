---
import { getCollection } from 'astro:content';

const productos = await getCollection('productos');
---

<html lang="es">
<head>
  <meta charset="UTF-8" />
  <title>Mi Catálogo</title>

  <style>
    body {
      font-family: Arial, sans-serif;
      background: #f5f5f5;
      margin: 0;
      padding: 20px;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill,minmax(280px,1fr));
      gap: 20px;
    }

    .card {
      background: white;
      border-radius: 12px;
      padding: 16px;
      box-shadow: 0 2px 8px rgba(0,0,0,.1);
    }

    .card img {
  width: 100%;
  height: 220px;
  object-fit: contain;
  background: white;
}

    h1 {
      margin-bottom: 30px;
    }

    .precio {
      font-size: 1.2rem;
      font-weight: bold;
      color: green;
    }
  </style>
</head>

<body>
  <h1>Ferreser Herramientas - Catálogo de Productos</h1>

  <div class="grid">
    {productos.map((producto) => (
      <div class="card">

        {producto.data.image && (
          <img
            src={producto.data.image}
            alt={producto.data.title}
          />
        )}

        <h2>{producto.data.title}</h2>

        <p>{producto.data.description}</p>

        <p class="precio">
          ${producto.data.price}
        </p>

        <p>
          Categoría: {producto.data.category}
        </p>

      </div>
    ))}
  </div>
</body>
</html>