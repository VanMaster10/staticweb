---
import { getCollection } from 'astro:content';

const productos = await getCollection('productos');

const whatsapp = '5491156423421';

const grupos = [...new Set(productos.map(p => p.data.grupo || 'Otros'))];

// Función para ordenar de forma estratégica para la venta
const ordenarEstrategico = (a, b) => {
  const tituloA = a.data.title.toLowerCase();
  const tituloB = b.data.title.toLowerCase();

  // 1. Lista de familias AMPLIADA (Menor número = aparece primero)
  const familias = [
    'amoladora', 
    'taladro', 
    'atornillador', 
    'rotomartillo', 
    'llave', 
    'sierra', 
    'lijadora', 
    'bateria', 
    'cargador'
  ];
  
  const getFamiliaPeso = (titulo) => {
    // Buscamos si el título incluye alguna de las palabras
    const index = familias.findIndex(f => titulo.includes(f));
    return index === -1 ? 99 : index; // 99 para las que no coinciden
  };

  const familiaA = getFamiliaPeso(tituloA);
  const familiaB = getFamiliaPeso(tituloB);

  // Si son de distinta familia, se ordenan por la familia
  if (familiaA !== familiaB) {
    return familiaA - familiaB;
  }

  // 2. Si son de la misma familia, priorizamos las que TIENEN batería (1) sobre las que NO (0)
  const bateriaA = a.data.incluye_bateria ? 1 : 0;
  const bateriaB = b.data.incluye_bateria ? 1 : 0;

  if (bateriaA !== bateriaB) {
    return bateriaB - bateriaA; // El 1 va antes que el 0
  }

  // 3. Si empatan en todo, ordenamos por precio (opcional)
  return b.data.price - a.data.price;
};
---

<html lang="es">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<title>Ferreser Herramientas</title>

<style>
  body {
    font-family: Arial, sans-serif;
    background: #f5f5f5;
    margin: 0;
    padding: 20px;
  }

  .header {
    background: #222;
    color: white;
    padding: 25px;
    border-radius: 12px;
    margin-bottom: 30px;
  }

  .header h1 {
    margin: 0 0 10px 0;
  }

  .header a {
    color: #25D366;
    font-weight: bold;
    text-decoration: none;
  }

  .grupo-titulo {
    margin-top: 40px;
    margin-bottom: 20px;
    color: #222;
    border-left: 6px solid #25D366;
    padding-left: 12px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill,minmax(320px,1fr));
    gap: 20px;
  }

  .card {
    background: white;
    border-radius: 12px;
    padding: 16px;
    box-shadow: 0 2px 10px rgba(0,0,0,.08);
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .destacado {
    position: absolute;
    top: 10px;
    right: 10px;
    background: #ff5722;
    color: white;
    padding: 6px 10px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: bold;
  }

  .image-container {
    height: 250px;
    display: flex;
    justify-content: center;
    align-items: center;
    margin-bottom: 15px;
  }

  .image-container img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .card h2 {
    min-height: 70px;
    margin-bottom: 10px;
  }

  .card .descripcion {
    min-height: 80px;
  }

  .precio {
    color: green;
    font-weight: bold;
    font-size: 28px;
    margin: 15px 0;
  }

  .btn-wpp {
    display: block;
    text-align: center;
    background: #25D366;
    color: white;
    text-decoration: none;
    font-weight: bold;
    padding: 12px;
    border-radius: 8px;
    margin-top: auto;
  }

  .btn-wpp:hover {
    background: #1fa851;
  }

  .wpp-float {
    position: fixed;
    bottom: 20px;
    right: 20px;
    width: 65px;
    height: 65px;
    background: #25D366;
    color: white;
    border-radius: 50%;
    text-decoration: none;
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 32px;
    box-shadow: 0 4px 10px rgba(0,0,0,.3);
  }
  
  .badge-verde{
    display:inline-block;
    background:#d4edda;
    color:#155724;
    padding:6px 10px;
    border-radius:6px;
    font-size:12px;
    font-weight:bold;
    margin-bottom:10px;
    align-self: flex-start;
  }

  .badge-naranja{
    display:inline-block;
    background:#fff3cd;
    color:#856404;
    padding:6px 10px;
    border-radius:6px;
    font-size:12px;
    font-weight:bold;
    margin-bottom:10px;
    align-self: flex-start;
  }
  
  .badge-cable{
    display:inline-block;
    background:#dbeafe;
    color:#1e40af;
    padding:6px 10px;
    border-radius:6px;
    font-size:12px;
    font-weight:bold;
    margin-bottom:10px;
    align-self: flex-start;
  }

  .badge-manual{
    display:inline-block;
    background:#e9ecef;
    color:#495057;
    padding:6px 10px;
    border-radius:6px;
    font-size:12px;
    font-weight:bold;
    margin-bottom:10px;
    align-self: flex-start;
  }
  
  .badge-kit{
    display:inline-block;
    background:#dbeafe;
    color:#1e40af;
    padding:6px 10px;
    border-radius:6px;
    font-size:12px;
    font-weight:bold;
    margin-bottom:10px;
    align-self: flex-start;
  }
</style>
</head>

<body>

<div class="header">
  <h1>🔧 Ferreser Herramientas</h1>

  <p>
    📞 WhatsApp:
    <a href={`https://wa.me/${whatsapp}`} target="_blank">
      11 5642-3421
    </a>
  </p>

  <p>
    📍 Zona Sur y CABA
  </p>
</div>

{
  grupos.map(grupo => (
    <>
      <h2 class="grupo-titulo">{grupo}</h2>

      <div class="grid">

        {
          productos
            .filter(p => (p.data.grupo || 'Otros') === grupo)
            // Aplicamos el orden estratégico solo al grupo Individuales
            .sort((a, b) => grupo === 'Individuales' ? ordenarEstrategico(a, b) : 0)
            .map(producto => {

              // Normalizamos los textos para evitar problemas de mayúsculas/minúsculas
              const alimentacion = (producto.data.alimentacion || '').trim().toLowerCase();
              const grupoLower = (producto.data.grupo || '').trim().toLowerCase();
              const categoryLower = (producto.data.category || '').trim().toLowerCase();

              // Evaluamos si es Kit
              const esKit = grupoLower === 'kits';

              // Evaluamos si es Cable (revisando alimentacion o category)
              const esCable = alimentacion === 'cable' || categoryLower === 'a cable';

              // Evaluamos si es Manual (revisando alimentacion o el nombre del grupo)
              const esManual = alimentacion === 'manual' || grupoLower === 'manuales' || categoryLower === 'manuales';

              return (
                <div class="card">

                  {
                    producto.data.destacado && (
                      <div class="destacado">
                        🔥 OFERTA
                      </div>
                    )
                  }

                  {/* Lógica de Badges Corregida */}
                  {
                    esKit ? (
                      <div class="badge-kit">🧰 Kit completo</div>
                    ) : esCable ? (
                      <div class="badge-cable">🔌 Eléctrica</div>
                    ) : esManual ? (
                      <div class="badge-manual">🔧 Manual</div>
                    ) : producto.data.incluye_bateria ? (
                      <div class="badge-verde">🔋 Con batería</div>
                    ) : (
                      <div class="badge-naranja">⚡ Solo herramienta</div>
                    )
                  }
                  
                  <div class="image-container">
                    <img
                      src={producto.data.image}
                      alt={producto.data.title}
                    />
                  </div>

                  <h2>{producto.data.title}</h2>

                  <p class="descripcion">
                    {producto.data.description}
                  </p>

                  <p class="precio">
                    ${producto.data.price}
                  </p>

                  <p>
                    Categoría: {producto.data.category}
                  </p>

                  <a
                    class="btn-wpp"
                    href={`https://wa.me/${whatsapp}?text=Hola, consulto por ${producto.data.title}`}
                    target="_blank"
                  >
                    Consultar por WhatsApp
                  </a>

                </div>
              )
            })
        }
      </div>
    </>
  ))
}

<a
  href={`https://wa.me/${whatsapp}`}
  class="wpp-float"
  target="_blank"
>
💬
</a>

</body>
</html>